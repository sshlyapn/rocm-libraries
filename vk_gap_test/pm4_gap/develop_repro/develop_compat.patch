diff --git a/projects/clr/rocclr/device/blitcl.cpp b/projects/clr/rocclr/device/blitcl.cpp
index a7d0d407376..cc09dcf86d7 100644
--- a/projects/clr/rocclr/device/blitcl.cpp
+++ b/projects/clr/rocclr/device/blitcl.cpp
@@ -27,9 +27,17 @@ const char* BlitLinearSourceCode = BLIT_KERNELS(
 
     extern void __amd_streamOpsWrite(__global uint*, __global ulong*, ulong);
 
-    extern void __amd_streamOpsIncrement(__global uint*, __global ulong*, ulong);
+    // Local fallback definitions: these builtins exist only in newer rocm-device-libs
+    // than the 7.2 hip.bc available on this box, so the blit program would otherwise
+    // fail to link. This benchmark build never dispatches the streamOps kernels, so a
+    // plain (non-atomic) impl is sufficient to satisfy the linker. Plain ASCII only.
+    void __amd_streamOpsIncrement(__global uint* pInt, __global ulong* pUlong, ulong value) {
+      if (pInt) { pInt[0] = pInt[0] + 1u; } else if (pUlong) { pUlong[0] = pUlong[0] + 1UL; }
+    }
 
-    extern void __amd_streamOpsDecrement(__global uint*, __global ulong*, ulong);
+    void __amd_streamOpsDecrement(__global uint* pInt, __global ulong* pUlong, ulong value) {
+      if (pInt) { pInt[0] = pInt[0] - 1u; } else if (pUlong) { pUlong[0] = pUlong[0] - 1UL; }
+    }
 
     extern void __amd_streamOpsWait(__global uint*, __global ulong*, ulong, ulong, ulong);
 
